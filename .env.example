# Required
DISCORD_TOKEN=replace_with_your_bot_token
CLIENT_ID=replace_with_your_discord_application_id

# Optional: set during development / single-server use for instant command updates.
# Leave blank for global commands.
GUILD_ID=

# Required only if you want to use /goldstatus.
# This is your personal Discord user ID. Presence is global across every server the bot joins.
OWNER_ID=

# Automatically registers slash commands whenever the bot starts.
REGISTER_COMMANDS_ON_START=true

# Optional defaults
DEFAULT_CURRENCY=USD
STATUS_REFRESH_MINUTES=5
ALERT_CHECK_SECONDS=60
PRICE_SAMPLE_MINUTES=5

# Optional database override.
# On Railway, leave this blank and attach a persistent volume; the bot will automatically
# store goldbot.sqlite inside RAILWAY_VOLUME_MOUNT_PATH.
DB_PATH=
